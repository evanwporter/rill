.{
    // Gap between windows and the output's top/bottom edge
    .vertical_gap = 9,
    // Gap between adjacent windows
    .horizontal_gap = 9,
    // Default proportion of the output's available width that a window occupies when spawned
    .default_window_width = 0.5,

    // Center the focused window (never, always, single)
    // Set it to single to center a window if it's the only window in the workspace
    .center_focused_window = .never,
    // Enable dynamic workspaces
    .dynamic_workspaces = false,
    // Number of workspaces (ignored if dynamic workspaces are enabled)
    .workspace_count = 10,

    .border = .{
        .width = 3,
        .focused_color = .{ .r = 141, .g = 214, .b = 0, .a = 1.0 },
        .unfocused_color = .{ .r = 160, .g = 160, .b = 160, .a = 1.0 },
    },

    // Disable client side decorations
    .no_csd = true,
    // Duration of animations, in milliseconds
    .animation_duration = 200,

    // Theme and size of cursor (set it to null to use default cursor)
    // .cursor = .{ .theme = "Adwaita", .size = 24 },
    .cursor = null,

    .spawn_at_startup = .{
        // .{ "command", "to", "run" },
        .{"noctalia"},
        .{ "wlr-randr", "--output", "eDP-1", "--scale", "1.75" },
        .{ "swaybg", "-i", "/home/evanp/dotfiles/nix/resources/wallpaper/gargantua-black-3840x2160-9621.jpg" },
    },

    .keybindings = .{
        // Join the column to the left, or split this window into a new column.
        .{ .key = "bracketleft", .modifiers = .{ .mod4 = true }, .action = .{ .set_window_stacked = true } },
        .{ .key = "bracketright", .modifiers = .{ .mod4 = true }, .action = .{ .set_window_stacked = false } },
        // Focus the window above or below within the column.
        .{ .key = "braceleft", .modifiers = .{ .mod4 = true, .shift = true }, .action = .focus_window_up },
        .{ .key = "braceright", .modifiers = .{ .mod4 = true, .shift = true }, .action = .focus_window_down },

        // Key: keysym names (case insensitive) from xkbcommon-keysyms.h
        // Common ones include:
        // "Left", "Up", "Right", "Down", "BackSpace", "Tab", "Space", "Return", "Escape", "Delete",
        // "XF86MonBrightnessUp", "XF86MonBrightnessDown",
        // "XF86AudioRaiseVolume", "XF86AudioLowerVolume", "XF86AudioMute", "XF86AudioMicMute"
        //
        // Modifiers: shift, ctrl, mod1 (alt), mod4 (super)

        .{ .key = "q", .modifiers = .{ .mod4 = true }, .action = .close_window },
        .{ .key = "m", .modifiers = .{ .mod4 = true }, .action = .toggle_maximize },
        .{ .key = "m", .modifiers = .{ .mod4 = true, .shift = true }, .action = .toggle_fullscreen },

        // Toggle floating mode for the current workspace
        // .{ .key = "v", .modifiers = .{ .mod4 = true }, .action = .toggle_workspace_floating },

        // Decrease focused window's width by 0.1 of the output's available width
        .{ .key = "minus", .modifiers = .{ .mod4 = true }, .action = .{ .adjust_window_width = -0.1 } },

        // Increase focused window's width by 0.1 of the output's available width
        .{ .key = "equal", .modifiers = .{ .mod4 = true }, .action = .{ .adjust_window_width = 0.1 } },

        // Set focused window's width to 0.5 of the output's available width
        // .{ .key = "BackSpace", .modifiers = .{ .mod4 = true }, .action = .{ .set_window_width = 0.5 } },

        .{ .key = "e", .modifiers = .{ .mod4 = true, .shift = true }, .action = .exit },
        .{ .key = "c", .modifiers = .{ .mod4 = true, .shift = true }, .action = .reload_config },

        // In passthrough mode all other bindings are disabled
        // to pass keyboard and mouse events to the client window
        // .{ .key = "F11", .modifiers = .{ .mod4 = true }, .action = .toggle_passthrough },

        // "Super t" to spawn alacritty
        .{ .key = "Return", .modifiers = .{ .mod4 = true }, .action = .{ .spawn = .{"kitty"} } },

        // Keybinding without modifier keys:
        // .{
        //     .key = "XF86AudioRaiseVolume",
        //     .modifiers = .{},
        //     .action = .{
        //         .spawn = .{ "wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "0.05+", "--limit", "1.0" },
        //     },
        // },

        .{
            .key = "space",
            .modifiers = .{ .mod4 = true },
            .action = .{
                .spawn = .{ "noctalia", "msg", "panel-toggle", "launcher" },
            },
        },

        .{
            .key = "h",
            .modifiers = .{ .mod4 = true },
            .action = .focus_window_left,

            // Alternatively, use focus_window_or_output_left to focus the left window
            // or the left output when no window is present on the left
            // .action = .focus_window_or_output_left,
        },
        .{
            .key = "l",
            .modifiers = .{ .mod4 = true },
            .action = .focus_window_right,
            // .action = .focus_window_or_output_right,
        },

        .{
            .key = "h",
            .modifiers = .{ .mod4 = true, .shift = true },
            .action = .move_window_left,
            // .action = .move_window_left_or_to_output_left,
        },
        .{
            .key = "l",
            .modifiers = .{ .mod4 = true, .shift = true },
            .action = .move_window_right,
            // .action = .move_window_right_or_to_output_right,
        },

        .{
            .key = "Up",
            .modifiers = .{ .mod4 = true },
            .action = .focus_workspace_above,
            // .action = .focus_workspace_or_output_above,
        },
        .{
            .key = "Down",
            .modifiers = .{ .mod4 = true },
            .action = .focus_workspace_below,
            // .action = .focus_workspace_or_output_below,
        },

        .{ .key = "1", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 1 } },
        .{ .key = "2", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 2 } },
        .{ .key = "3", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 3 } },
        .{ .key = "4", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 4 } },
        .{ .key = "5", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 5 } },
        .{ .key = "6", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 6 } },
        .{ .key = "7", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 7 } },
        .{ .key = "8", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 8 } },
        .{ .key = "9", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 9 } },
        .{ .key = "0", .modifiers = .{ .mod4 = true }, .action = .{ .focus_workspace_number = 10 } },

        // .{ .key = "grave", .modifiers = .{ .mod4 = true }, .action = .focus_workspace_previous },

        .{
            .key = "Up",
            .modifiers = .{ .mod4 = true, .shift = true },
            .action = .move_window_to_workspace_above,
            // .action = .move_window_to_workspace_or_output_above,

        },
        .{
            .key = "Down",
            .modifiers = .{ .mod4 = true, .shift = true },
            .action = .move_window_to_workspace_below,
            // .action = .move_window_to_workspace_or_output_below,

        },

        .{ .key = "1", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 1 } },
        .{ .key = "2", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 2 } },
        .{ .key = "3", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 3 } },
        .{ .key = "4", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 4 } },
        .{ .key = "5", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 5 } },
        .{ .key = "6", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 6 } },
        .{ .key = "7", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 7 } },
        .{ .key = "8", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 8 } },
        .{ .key = "9", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 9 } },
        .{ .key = "0", .modifiers = .{ .mod4 = true, .shift = true }, .action = .{ .move_window_to_workspace_number = 10 } },

        // Send window away without leaving the current workspace
        .{
            .key = "Up",
            .modifiers = .{ .mod4 = true, .ctrl = true },
            .action = .send_window_to_workspace_above,
            // .action = .send_window_to_workspace_or_output_above,

        },
        .{
            .key = "Down",
            .modifiers = .{ .mod4 = true, .ctrl = true },
            .action = .send_window_to_workspace_below,
            // .action = .send_window_to_workspace_or_output_below,
        },

        .{ .key = "1", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 1 } },
        .{ .key = "2", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 2 } },
        .{ .key = "3", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 3 } },
        .{ .key = "4", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 4 } },
        .{ .key = "5", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 5 } },
        .{ .key = "6", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 6 } },
        .{ .key = "7", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 7 } },
        .{ .key = "8", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 8 } },
        .{ .key = "9", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 9 } },
        .{ .key = "0", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .{ .send_window_to_workspace_number = 10 } },

        .{ .key = "h", .modifiers = .{ .mod4 = true }, .action = .focus_output_left },
        .{ .key = "l", .modifiers = .{ .mod4 = true }, .action = .focus_output_right },
        .{ .key = "k", .modifiers = .{ .mod4 = true }, .action = .focus_output_above },
        .{ .key = "j", .modifiers = .{ .mod4 = true }, .action = .focus_output_below },

        .{ .key = "h", .modifiers = .{ .mod4 = true, .shift = true }, .action = .move_window_to_output_left },
        .{ .key = "l", .modifiers = .{ .mod4 = true, .shift = true }, .action = .move_window_to_output_right },
        .{ .key = "k", .modifiers = .{ .mod4 = true, .shift = true }, .action = .move_window_to_output_above },
        .{ .key = "j", .modifiers = .{ .mod4 = true, .shift = true }, .action = .move_window_to_output_below },

        .{ .key = "h", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .send_window_to_output_left },
        .{ .key = "l", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .send_window_to_output_right },
        .{ .key = "k", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .send_window_to_output_above },
        .{ .key = "j", .modifiers = .{ .mod4 = true, .ctrl = true }, .action = .send_window_to_output_below },
    },

    .pointer_bindings = .{
        // Button: left, right, middle
        // Works only for floating windows
        .{ .button = .left, .modifiers = .{ .mod4 = true }, .action = .move_window },
        .{ .button = .right, .modifiers = .{ .mod4 = true }, .action = .resize_window },
    },
}
